<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      This module (transitively, via core:ui) depends on the Google Mobile Ads SDK, whose
      MobileAdsInitProvider crashes the instrumented test process at startup unless this
      meta-data is present. Google's publicly documented sample/test AdMob App ID is used here
      (https://developers.google.com/admob/android/test-ads) - the real app supplies its own
      via a manifest placeholder, which isn't available in this isolated test APK.
    -->
    <application>
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
    </application>
</manifest>
